# Generated automatically by configure.py. DO NOT EDIT DIRECTLY.
ninja_required_version = 1.10

# Core Tool Variables
COQC = /opt/homebrew/bin/coqc
CC = /usr/bin/clang
CXX = /usr/bin/clang++
PYTHON = .venv/bin/python3
COQFLAGS = -Q . ""
CFLAGS = -O3 -Wall -Wextra -pedantic
CXXFLAGS = -O3 -std=c++23 -Wall -Wextra

# Rule: Rocq/Coq formal proof verification
rule coqc
  command = $COQC $COQFLAGS $in
  description = COQC $in

# Rule: Zero-admit integrity verifier across all formal theories
rule verify_admits
  command = if grep -rn -E "\b(admit|Admitted)\b" *.v; then echo "\033[31m[ERROR] Found admits in Coq theories!\033[0m"; exit 1; else echo "\033[32m[PASS] All formal theories verified with strictly 0 admits.\033[0m"; touch $out; fi
  description = VERIFY_ZERO_ADMITS

# Rule: C99 Object Compilation
rule c_compile
  command = $CC $CFLAGS -c $in -o $out
  description = CC $in -> $out

# Rule: C99 Executable Linking
rule c_link
  command = $CC $CFLAGS $in -o $out
  description = LINK $out

# Rule: C++23 Compilation
rule cpp_compile
  command = $CXX $CXXFLAGS -c $in -o $out
  description = CXX $in -> $out

# Rule: LLVM IR Generation
rule llvm_ir
  command = $CC -S -emit-llvm -O3 $in -o $out
  description = LLVM_IR $out

# Rule: Native Assembly Generation
rule asm_gen
  command = $CC -S -O3 $in -o $out
  description = ASM $out

# Rule: Shared Dynamic Library
rule shared_lib
  command = $CC -shared -fPIC -O3 $in -o $out
  description = DYLIB $out

# Rule: Formal Runner Execution
rule run_runner
  command = ./$in > $out && cat $out
  description = RUN_FORMAL_ENGINE

# Rule: Reconfigure build system if configure.py changes
rule reconfigure
  command = $PYTHON configure.py
  generator = 1

build build.ninja: reconfigure configure.py

