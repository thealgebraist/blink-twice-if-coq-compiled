CppExpr("e_neg", "VarRef"). CppVarRef("e_neg", "neg").
CppExpr("e_inc", "VarRef"). CppVarRef("e_inc", "inc").
CppExpr("e_zero", "ConstInt"). CppConstInt("e_zero", 0).

CppExpr("c_pos_inc", "BinOp"). CppBinOp("c_pos_inc", "<", "e_zero", "e_inc").
CppExpr("c_update_pos", "BinOp"). CppBinOp("c_update_pos", "<", "e_pos", "e_inc").
CppExpr("c_update_neg", "BinOp"). CppBinOp("c_update_neg", "<", "e_inc", "e_neg").

CppExpr("e_eff_pos", "Ternary"). CppTernary("e_eff_pos", "c_update_pos", "e_inc", "e_pos").
CppExpr("e_eff_neg", "Ternary"). CppTernary("e_eff_neg", "c_update_neg", "e_inc", "e_neg").

CppStmt("s_ret_pos_branch", "ReturnTuple2"). CppReturnTuple2("s_ret_pos_branch", "e_eff_pos", "e_neg").
CppStmt("s_ret_neg_branch", "ReturnTuple2"). CppReturnTuple2("s_ret_neg_branch", "e_pos", "e_eff_neg").

CppStmt("s_margin_root", "If"). CppIf("s_margin_root", "c_pos_inc", "s_ret_pos_branch", "s_ret_neg_branch").

