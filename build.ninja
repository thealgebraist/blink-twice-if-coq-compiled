build .admits_verified: verify_admits coq_all

build blink_formal_engine.o: c_compile blink_formal_engine.c
build blink_formal_runner.o: c_compile blink_formal_runner.c
build blink_formal_runner: c_link blink_formal_engine.o blink_formal_runner.o
build blink_formal_engine_cpp.o: cpp_compile blink_formal_engine.cpp
build libblink_formal.dylib: shared_lib blink_formal_engine.c
build blink_formal_engine.ll: llvm_ir blink_formal_engine.c
build blink_formal_engine.s: asm_gen blink_formal_engine.c

build engine_all: phony blink_formal_runner blink_formal_engine_cpp.o libblink_formal.dylib blink_formal_engine.ll blink_formal_engine.s
build .engine_tested: run_runner blink_formal_runner
build test: phony .admits_verified .engine_tested
build all: phony coq_all .admits_verified engine_all .engine_tested
default all

